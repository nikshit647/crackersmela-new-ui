# ===== Spring Boot storefront (origin/main) =====

# Build output
target/
*.class
*.jar
*.war

# Backups / source dumps (EXCLUDE - may contain data)
crackersmela-files-backup/
crackersmela-files-backup.tar.gz
crackersmela-database.sql

# Separate/legacy projects and tooling
crackersmela-api/
.freebuff/

# Secrets & config
.env
.env.*
!.env.example
*.pem
*.key
application-secrets.yml

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ===== Local UI review harness (codex/local-audit) =====

# Deployed evidence can contain exposed credentials; never publish it.
live-app.js
live-index.html
audit/screenshots/
audit-evidence/
# audit-artifacts/ contains verbatim copies of deployed production app.js
# (Firebase API key + demo admin credentials). Same class as audit-evidence/.
audit-artifacts/
.codex-mine/
.backup-*/
__pycache__/
tmp-probe.txt

# Images: only the review harness product/logo images are intentional.
*.png
!review/public/images/**/*.png

# Node / logs (shared)
node_modules/
*.log